{
    parserClass="eu.bcosp.vrlintellij.parser.VRLParser"
    parserUtilClass="eu.bcosp.vrlintellij.parser.VRLParserUtil"
    extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

    psiClassPrefix="VRL"
    psiImplClassSuffix="Impl"
    psiPackage="eu.bcosp.vrlintellij.psi"
    psiImplPackage="eu.bcosp.vrlintellij.psi.impl"

    elementTypeHolderClass="eu.bcosp.vrlintellij.psi.VRLElementTypes"
    elementTypeClass="eu.bcosp.vrlintellij.psi.VRLCompositeType"
    tokenTypeClass="eu.bcosp.vrlintellij.psi.VRLTokenType"

    tokens=[
        // Whitespace and comments. NEWLINE isn't declared here: Grammar-Kit doesn't emit a
        // VRLElementTypes constant for a token whose pattern matches only whitespace characters
        // (same as WHITE_SPACE itself) - see eu.bcosp.vrlintellij.psi.NEWLINE.
        WHITE_SPACE='regexp:\s+'
        COMMENT='regexp:#[^\r\n]*'

        // Keywords
        IF='if'
        ELSE='else'
        BREAK='break'
        RETURN='return'
        ABORT='abort'
        TRUE='true'
        FALSE='false'
        NULL='null'

        // Operators
        ASSIGN='='
        MERGE_ASSIGN='|='
        EQ='=='
        NE='!='
        GE='>='
        LE='<='
        GT='>'
        LT='<'
        AND='&&'
        OR='||'
        NULL_COALESCE='??'
        NOT='!'
        PLUS='+'
        MINUS='-'
        STAR='*'
        SLASH='/'
        PERCENT='%'
        PIPE='|'

        // Punctuation
        LPAREN='('
        RPAREN=')'
        LBRACE='{'
        RBRACE='}'
        LBRACKET='['
        RBRACKET=']'
        COMMA=','
        COLON=':'
        SEMICOLON=';'
        DOT='.'
        QUESTION='?'
        ARROW='->'

        // Literals. These patterns are reference only - lexing is done by VRLLexer.flex, which is
        // the file to change if a token's shape is wrong. They are kept in step with it because
        // this block is what anyone reads first to learn the token shapes.
        //
        // The three quoted forms share one rule, mirroring vrl's own lexer (quoted_literal in
        // src/parser/lex.rs, which raw_string_literal/regex_literal/timestamp_literal all call): a
        // backslash escapes whatever character follows it, and the first unescaped quote ends the
        // literal. There is no doubled-quote escape - `vector vrl` rejects s'a''b' with error 203 -
        // and a trailing backslash swallows the closing quote, leaving the literal unterminated
        // (error 208). The backslash only affects where the literal *ends*: the escape stays in
        // the token's content, so s'a\'b' is the four characters a \ ' b, which is why
        // VRLRawLiteralEscaper decodes by straight substring copy.
        FLOAT_LITERAL='regexp:-?[0-9][0-9_]*\.[0-9][0-9_]*'
        INTEGER_LITERAL='regexp:-?[0-9][0-9_]*'
        STRING='regexp:"([^"\\]|\\.)*"'
        RAW_STRING="regexp:s'([^'\\]|\\.)*'"
        REGEX="regexp:r'([^'\\]|\\.)*'"
        TIMESTAMP="regexp:t'([^'\\]|\\.)*'"
        IDENTIFIER='regexp:[a-zA-Z_@][a-zA-Z0-9_@]*'
        FUNCTION_CALL='regexp:[a-zA-Z_@][a-zA-Z0-9_@]*(?=[(!])'
        // Both shaped like IDENTIFIER; VRLLexer.flex picks them out by content (see there).
        PATH_FIELD='path field'
        RESERVED_IDENTIFIER='reserved identifier'
    ]
}

root ::= statement*

// vrl's parser.lalrpop (Exprs/EndOfExpression) needs a newline or `;` between two expressions:
// `.a = 1 .b = 2` is E203. Pinned so a missing separator is reported at the gap while the next
// statement still parses on its own rather than being lost.
statement ::= statement_body statement_end {pin=1}

private statement_body ::= multi_assignment_expr | expression

private statement_end ::= SEMICOLON | <<newlineBefore>> | &RBRACE | <<eof>> {name="';' or new line"}

expression ::= assignment_expr

// Every continuation point below (an operator or postfix suffix that would extend the previous
// value) is gated by `!<<newlineBefore>>`: a value followed by a raw newline is a complete
// statement per VRL's "expressions can be separated by newline or semicolon" rule, so a line
// break blocks the continuation the same way a semicolon inside `statement` would - without it,
// e.g. `x = 1\n.foo = 2` silently parses as one statement `x = (1.foo = 2)` instead of two.
// Purely additive positions (LPAREN/LBRACKET/LBRACE bodies, `multi_assignment_expr`'s own
// required comma) are left unguarded since a failed predicate there would fail the whole rule
// rather than just stop a repetition, and multi-line calls/arrays/objects must keep working.
assignment_expr ::= null_coalesce_expr (!<<newlineBefore>> (ASSIGN | MERGE_ASSIGN) assignment_expr)?

// `value, err = fallible_call()` is VRL's standard error-destructuring assignment form, used
// alongside the `!` raise-on-error suffix. Kept separate from `assignment_expr` (rather than an
// optional `(COMMA null_coalesce_expr)?` folded into it) because that would greedily swallow any following
// `, <expr>` - breaking argument lists and array/object literals, which also route through
// `assignment_expr` via `expression`. Scoping this to `statement` matches how VRL actually uses
// it: only as a standalone statement, never nested inside another expression.
multi_assignment_expr ::= null_coalesce_expr COMMA null_coalesce_expr (ASSIGN | MERGE_ASSIGN) assignment_expr

// Binary precedence, loosest first, per vrl's parser.lalrpop: ErrorCoalesce (`??`), Logical
// (`||` and `&&` on one level), Equal/Compare, Merge (`|`), Add, Factor, Not.
null_coalesce_expr ::= logical_expr (!<<newlineBefore>> NULL_COALESCE logical_expr)*

logical_expr ::= comparison_expr (!<<newlineBefore>> (OR | AND) comparison_expr)*

// parser.lalrpop splits this into Equal and Compare and lets both chain, but the compiler then
// rejects any chain (E650 "comparison operators can't be chained together"), so one
// non-repeating level reports the same programs as broken.
comparison_expr ::= merge_expr (!<<newlineBefore>> (EQ | NE | GT | GE | LT | LE) merge_expr)?

merge_expr ::= additive_expr (!<<newlineBefore>> PIPE additive_expr)*

additive_expr ::= multiplicative_expr (!<<newlineBefore>> (PLUS | MINUS) multiplicative_expr)*

// No `%`: it only ever starts a metadata path (`5 % 2` is E203; modulo is the `mod` function).
multiplicative_expr ::= unary_expr (!<<newlineBefore>> (STAR | SLASH) unary_expr)*

// Only `!`: there's no unary minus - a `-` glued to a digit is part of the number literal
// (see VRLLexer.flex), and `-x` / `-(1)` / `- 1` are all E203.
unary_expr ::= NOT* postfix_expr

postfix_expr ::= primary_expr (!<<newlineBefore>> postfix_suffix)*

// Bracket indexing is integer-literal only in VRL - there's no dynamic/computed indexing by a
// variable or arbitrary expression (confirmed against the vrl CLI: `.x[i]` and `.x["key"]` are
// both syntax errors, only `.x[0]` is valid).
// A path never has whitespace inside it: `x .b`, `x. b`, `.a .b` and `[1] [0]` are all E203 in
// `vector vrl` (vrl's lexer only continues a query on an adjacent character). Without this,
// `.a = 1 .b = 2` parsed as `.a = (1.b = 2)` instead of reporting the missing separator.
postfix_suffix ::= call_suffix
                 | <<adjacent>> bracket_index
                 | <<adjacent>> DOT <<adjacent>> (field_name | STRING)

// Pinned so `.foo[not-an-integer]` reports a real "integer literal expected" error at the bad
// token. Without the pin, a failed match here would just make postfix_expr's repetition stop
// silently (zero-or-more), letting the leftover `[...]` get reparsed as an unrelated new
// statement (e.g. `.x = .foo["bar"]` silently splitting into `.x = .foo` plus a disconnected,
// no-op `["bar"]` array-literal statement) instead of surfacing the mistake.
private bracket_index ::= LBRACKET INTEGER_LITERAL RBRACKET {pin=1}

call_suffix ::= raise_flag? LPAREN argument_list? RPAREN (ARROW closure_expr)?

argument_list ::= argument (COMMA argument)* COMMA?

argument ::= IDENTIFIER COLON expression
           | assignment_expr

primary_expr ::= literal
               | path_expr
               | metadata_path_expr
               | IDENTIFIER
               | FUNCTION_CALL
               | block_expr
               | if_expr
               | abort_expr
               | return_expr
               | break_expr
               | LPAREN expression RPAREN
               | array_expr
               | object_expr
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLPrimaryExprMixin"
}

literal ::= FLOAT_LITERAL
          | INTEGER_LITERAL
          | STRING
          | RAW_STRING
          | TRUE
          | FALSE
          | NULL
          | REGEX
          | TIMESTAMP
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLLiteralMixin"
}

// Segments must touch (see postfix_suffix) - which also stops one continuing past a line break:
// `e = .` then `p = 1` on the next line are two statements in `vector vrl`, not `e = .p = 1`.
path_expr ::= DOT (<<adjacent>> path_segment)*

// The `%` sigil addresses event metadata instead of the event body, e.g. `%datadog_api_key`;
// otherwise it follows the same segment syntax as a `.` event path.
metadata_path_expr ::= PERCENT (<<adjacent>> path_segment)*

// Brackets are array-index only (`.items[0]`) - a quoted object key uses the dot-string form
// instead (`.headers."User-Agent"`), never brackets (`.headers["User-Agent"]` is a syntax error
// in real VRL, confirmed against the vrl CLI).
path_segment ::= field_name | STRING | LBRACKET INTEGER_LITERAL RBRACKET

// parser.lalrpop's Field: any identifier, a PathField (`@timestamp`), a reserved identifier, or a
// keyword - `.if`, `.null`, `.for` and `.string` are all ordinary field names.
private field_name ::= IDENTIFIER | PATH_FIELD | RESERVED_IDENTIFIER
                     | IF | ELSE | NULL | TRUE | FALSE | ABORT | RETURN | BREAK

block_expr ::= LBRACE statement* RBRACE

if_expr ::= IF expression block_expr (ELSE (if_expr | block_expr))?

abort_expr ::= ABORT expression?

return_expr ::= RETURN expression?

break_expr ::= BREAK

array_expr ::= LBRACKET (expression (COMMA expression)* COMMA?)? RBRACKET

object_expr ::= LBRACE (object_field (COMMA object_field)* COMMA?)? RBRACE

// parser.lalrpop's ObjectKey is a string literal only: `{a: 1}` is E203.
object_field ::= STRING COLON expression

// Only reachable after `->` (call_suffix): anywhere else a `|` is the merge operator. `||` lexes
// as OR, which is how an empty parameter list is spelled.
closure_expr ::= (PIPE closure_params? PIPE | OR) expression

closure_params ::= closure_param (COMMA closure_param)*

closure_param ::= IDENTIFIER
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLClosureParamMixin"
}

raise_flag ::= NOT
