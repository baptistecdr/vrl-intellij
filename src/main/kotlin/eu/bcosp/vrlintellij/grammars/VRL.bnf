{
    parserClass="eu.bcosp.vrlintellij.parser.VRLParser"
    parserUtilClass="eu.bcosp.vrlintellij.parser.VRLParserUtil"
    extends="com.intellij.extapi.psi.ASTWrapperPsiElement"

    psiClassPrefix="VRL"
    psiImplClassSuffix="Impl"
    psiPackage="eu.bcosp.vrlintellij.psi"
    psiImplPackage="eu.bcosp.vrlintellij.psi.impl"

    elementTypeHolderClass="eu.bcosp.vrlintellij.psi.VRLElementTypes"
    elementTypeClass="eu.bcosp.vrlintellij.psi.VRLCompositeType"
    tokenTypeClass="eu.bcosp.vrlintellij.psi.VRLTokenType"

    tokens=[
        // Whitespace and comments. NEWLINE isn't declared here: Grammar-Kit doesn't emit a
        // VRLElementTypes constant for a token whose pattern matches only whitespace characters
        // (same as WHITE_SPACE itself) - see eu.bcosp.vrlintellij.psi.NEWLINE.
        WHITE_SPACE='regexp:\s+'
        COMMENT='regexp:#[^\r\n]*'

        // Keywords
        IF='if'
        ELSE='else'
        FOR='for'
        WHILE='while'
        LOOP='loop'
        BREAK='break'
        CONTINUE='continue'
        RETURN='return'
        ABORT='abort'
        TRUE='true'
        FALSE='false'
        NULL='null'
        IN='in'

        // Operators
        ASSIGN='='
        MERGE_ASSIGN='|='
        NULL_COALESCE_ASSIGN='??='
        EQ='=='
        NE='!='
        GE='>='
        LE='<='
        GT='>'
        LT='<'
        AND='&&'
        OR='||'
        NULL_COALESCE='??'
        NOT='!'
        PLUS='+'
        MINUS='-'
        STAR='*'
        SLASH='/'
        PERCENT='%'
        PIPE='|'

        // Punctuation
        LPAREN='('
        RPAREN=')'
        LBRACE='{'
        RBRACE='}'
        LBRACKET='['
        RBRACKET=']'
        COMMA=','
        COLON=':'
        SEMICOLON=';'
        DOT='.'
        QUESTION='?'
        ARROW='->'

        // Literals (regexp patterns for reference)
        FLOAT_LITERAL='regexp:[0-9][0-9_]*\.[0-9][0-9_]*([eE][+-]?[0-9]+)?'
        INTEGER_LITERAL='regexp:[0-9][0-9_]*'
        STRING='regexp:"([^"\\]|\\.)*"'
        RAW_STRING="regexp:s'([^']|'')*'"
        REGEX="regexp:r'([^']|'')*'"
        TIMESTAMP="regexp:t'[^']*'"
        IDENTIFIER='regexp:[a-zA-Z_][a-zA-Z0-9_]*'
        FUNCTION_CALL='regexp:[a-zA-Z_][a-zA-Z0-9_]*(?=[(!])'
    ]
}

root ::= statement*

statement ::= multi_assignment_expr (SEMICOLON | &RBRACE)?
            | expression (SEMICOLON | &RBRACE)?

expression ::= assignment_expr

// Every continuation point below (an operator or postfix suffix that would extend the previous
// value) is gated by `!<<newlineBefore>>`: a value followed by a raw newline is a complete
// statement per VRL's "expressions can be separated by newline or semicolon" rule, so a line
// break blocks the continuation the same way a semicolon inside `statement` would - without it,
// e.g. `x = 1\n.foo = 2` silently parses as one statement `x = (1.foo = 2)` instead of two.
// Purely additive positions (LPAREN/LBRACKET/LBRACE bodies, `multi_assignment_expr`'s own
// required comma) are left unguarded since a failed predicate there would fail the whole rule
// rather than just stop a repetition, and multi-line calls/arrays/objects must keep working.
assignment_expr ::= or_expr (!<<newlineBefore>> (ASSIGN | MERGE_ASSIGN | NULL_COALESCE_ASSIGN) assignment_expr)?

// `value, err = fallible_call()` is VRL's standard error-destructuring assignment form, used
// alongside the `!` raise-on-error suffix. Kept separate from `assignment_expr` (rather than an
// optional `(COMMA or_expr)?` folded into it) because that would greedily swallow any following
// `, <expr>` - breaking argument lists and array/object literals, which also route through
// `assignment_expr` via `expression`. Scoping this to `statement` matches how VRL actually uses
// it: only as a standalone statement, never nested inside another expression.
multi_assignment_expr ::= or_expr COMMA or_expr (ASSIGN | MERGE_ASSIGN | NULL_COALESCE_ASSIGN) assignment_expr

or_expr ::= and_expr (!<<newlineBefore>> OR and_expr)*

and_expr ::= null_coalesce_expr (!<<newlineBefore>> AND null_coalesce_expr)*

null_coalesce_expr ::= comparison_expr (!<<newlineBefore>> NULL_COALESCE comparison_expr)*

comparison_expr ::= additive_expr (!<<newlineBefore>> (EQ | NE | GT | GE | LT | LE) additive_expr)?

additive_expr ::= multiplicative_expr (!<<newlineBefore>> (PLUS | MINUS) multiplicative_expr)*

multiplicative_expr ::= unary_expr (!<<newlineBefore>> (STAR | SLASH | PERCENT) unary_expr)*

unary_expr ::= (NOT | MINUS)* postfix_expr

postfix_expr ::= primary_expr (!<<newlineBefore>> postfix_suffix)*

postfix_suffix ::= call_suffix
                 | LBRACKET expression RBRACKET
                 | DOT (IDENTIFIER | STRING)
                 | QUESTION

call_suffix ::= raise_flag? LPAREN argument_list? RPAREN (ARROW closure_expr)?

argument_list ::= argument (COMMA argument)* COMMA?

argument ::= IDENTIFIER COLON expression
           | assignment_expr

primary_expr ::= literal
               | path_expr
               | metadata_path_expr
               | IDENTIFIER
               | FUNCTION_CALL
               | block_expr
               | if_expr
               | for_expr
               | while_expr
               | loop_expr
               | abort_expr
               | return_expr
               | LPAREN expression RPAREN
               | array_expr
               | object_expr
               | closure_expr
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLPrimaryExprMixin"
}

literal ::= FLOAT_LITERAL
          | INTEGER_LITERAL
          | STRING
          | RAW_STRING
          | TRUE
          | FALSE
          | NULL
          | REGEX
          | TIMESTAMP
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLLiteralMixin"
}

path_expr ::= DOT path_segment*

// The `%` sigil addresses event metadata instead of the event body, e.g. `%datadog_api_key`;
// otherwise it follows the same segment syntax as a `.` event path.
metadata_path_expr ::= PERCENT path_segment*

path_segment ::= IDENTIFIER | STRING | LBRACKET (INTEGER_LITERAL | STRING) RBRACKET

block_expr ::= LBRACE statement* RBRACE

if_expr ::= IF expression block_expr (ELSE (if_expr | block_expr))?

for_expr ::= FOR IDENTIFIER (COMMA IDENTIFIER)? IN expression block_expr

while_expr ::= WHILE expression block_expr

loop_expr ::= LOOP block_expr

abort_expr ::= ABORT expression?

return_expr ::= RETURN expression?

array_expr ::= LBRACKET (expression (COMMA expression)* COMMA?)? RBRACKET

object_expr ::= LBRACE (object_field (COMMA object_field)* COMMA?)? RBRACE

object_field ::= (IDENTIFIER | STRING) COLON expression

closure_expr ::= PIPE closure_params? PIPE expression

closure_params ::= closure_param (COMMA closure_param)*

closure_param ::= IDENTIFIER
{
  mixin="eu.bcosp.vrlintellij.psi.impl.VRLClosureParamMixin"
}

raise_flag ::= NOT
