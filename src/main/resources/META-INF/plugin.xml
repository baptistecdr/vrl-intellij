<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>eu.bcosp.vrl-intellij</id>

    <!-- Public plugin name should be written in Title Case.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>VRL (Vector Remap Language)</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/baptistecdr">Baptiste C.</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        <p>
            Language support for <a href="https://vector.dev/docs/reference/vrl/">VRL (Vector Remap Language)</a>,
            the observability data transformation language from <a href="https://vector.dev">Vector</a>.
        </p>
        <ul>
            <li>Syntax highlighting for all VRL literal kinds (strings, raw strings, regexes, timestamps, string interpolation) with a customizable color scheme page</li>
            <li>Code completion for functions, in-scope variables, and named argument names</li>
            <li>Parameter info showing a function's signature while typing a call</li>
            <li>Quick documentation on hover for every VRL function</li>
            <li>Go to Declaration, Find Usages, and Rename for variables and closure parameters</li>
            <li>Introduce Variable refactoring</li>
            <li>Structure view listing a script's statements, including nested blocks</li>
            <li>Reformat Code support for blocks, objects, arrays, and operator spacing</li>
            <li>Language injection into string, raw string, and regex literals</li>
            <li>Postfix templates: <code>expr.iferr</code> and <code>expr.raise</code> for VRL's error-handling forms</li>
            <li>Code folding, brace/bracket/quote matching, and line commenting</li>
            <li>Inline type hints on assignments, including VRL's error-destructuring form (<code>value, err = fallible_call()</code>)</li>
            <li>Inspections for unknown function names, invalid RFC 3339 timestamp literals, unhandled fallible function calls, invalid function-call arguments, and unused variables</li>
        </ul>
        <p>
            This is an unofficial plugin and is not affiliated with the official VRL project.
        </p>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="VRL" language="VRL" extensions="vrl" fieldName="INSTANCE"
                  implementationClass="eu.bcosp.vrlintellij.VRLFileType"/>

        <lang.parserDefinition
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.psi.VRLParserDefinition"/>

        <lang.syntaxHighlighterFactory
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.highlighting.VRLHighlighterFactory"/>

        <colorSettingsPage
                implementation="eu.bcosp.vrlintellij.colors.VRLColorSettingsPage"/>

        <annotator
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.annotators.VRLNamedArgumentAnnotator"/>

        <annotator
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.annotators.VRLPathAnnotator"/>

        <annotator
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.annotators.VRLClosureParameterAnnotator"/>

        <completion.contributor
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.contributors.VRLCompletionContributor"/>

        <lang.documentationProvider
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.documentation.VRLDocumentationProvider"/>

        <lang.commenter
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.commenter.VRLCommenter"/>

        <lang.braceMatcher
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.matching.VRLBraceMatcher"/>

        <lang.quoteHandler
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.quotes.VRLQuoteHandler"/>

        <quoteHandler
                fileType="VRL"
                className="eu.bcosp.vrlintellij.quotes.VRLQuoteHandler"/>

        <lang.foldingBuilder
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.folding.VRLFoldingBuilder"/>

        <lang.formatter
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.formatting.VRLFormattingModelBuilder"/>

        <lang.findUsagesProvider
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.references.VRLFindUsagesProvider"/>

        <lang.psiStructureViewFactory
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.structureView.VRLStructureViewFactory"/>

        <codeInsight.template.postfixTemplateProvider
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.postfix.VRLPostfixTemplateProvider"/>

        <lang.refactoringSupport
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.refactoring.VRLRefactoringSupportProvider"/>

        <referencesSearch
                implementation="eu.bcosp.vrlintellij.references.VRLReferencesSearcher"/>

        <localInspection
                language="VRL"
                shortName="VRLUnknownFunction"
                displayName="Unknown function"
                groupName="VRL"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="eu.bcosp.vrlintellij.inspections.VRLUnknownFunctionInspection"/>

        <localInspection
                language="VRL"
                shortName="VRLInvalidTimestamp"
                displayName="Invalid timestamp literal"
                groupName="VRL"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="eu.bcosp.vrlintellij.inspections.VRLInvalidTimestampInspection"/>

        <localInspection
                language="VRL"
                shortName="VRLUnhandledFallibleCall"
                displayName="Unhandled fallible function call"
                groupName="VRL"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="eu.bcosp.vrlintellij.inspections.VRLUnhandledFallibleCallInspection"/>

        <localInspection
                language="VRL"
                shortName="VRLFunctionArguments"
                displayName="Invalid function-call arguments"
                groupName="VRL"
                enabledByDefault="true"
                level="ERROR"
                implementationClass="eu.bcosp.vrlintellij.inspections.VRLFunctionArgumentsInspection"/>

        <localInspection
                language="VRL"
                shortName="VRLUnusedVariable"
                displayName="Unused variable"
                groupName="VRL"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="eu.bcosp.vrlintellij.inspections.VRLUnusedVariableInspection"/>

        <codeInsight.parameterInfo
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.parameterInfo.VRLParameterInfoHandler"/>

        <codeInsight.declarativeInlayProvider
                language="VRL"
                implementationClass="eu.bcosp.vrlintellij.hints.VRLTypeHintsProvider"
                group="TYPES_GROUP"
                providerId="eu.bcosp.vrlintellij.typeHints"
                isEnabledByDefault="true"
                bundle="messages.VRLBundle"
                nameKey="inlay.hints.type.name"
                descriptionKey="inlay.hints.type.description"/>
    </extensions>
</idea-plugin>
